<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>NANO SPACE</title>
<style>
  :root {
    --bg: #0a0e1a;
    --panel: rgba(255,255,255,0.04);
    --panel-border: rgba(255,255,255,0.08);
    --text: #e8ebf5;
    --text-dim: #8b93a8;
    --accent1: #8b5cf6;
    --accent2: #3b82f6;
    --accent3: #22d3ee;
    --danger: #f87171;
    --success: #34d399;
    --radius: 16px;
    --shadow: 0 8px 30px rgba(0,0,0,0.35);
    --topbar-h: 62px;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: radial-gradient(circle at 20% 0%, #16203a 0%, var(--bg) 45%), var(--bg);
    color: var(--text);
    min-height: 100%;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 8px; }

  .glass {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius);
    backdrop-filter: blur(14px);
    box-shadow: var(--shadow);
  }

  /* Topbar */
  .topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 20px;
    padding-top: calc(12px + env(safe-area-inset-top, 0px));
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(10,14,26,0.9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--panel-border);
  }
  .brand {
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(90deg, var(--accent1), var(--accent3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }
  nav.mainnav { display: flex; gap: 4px; flex: 1; flex-wrap: wrap; }
  nav.mainnav a {
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 14px;
    color: var(--text-dim);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  nav.mainnav a:hover { background: rgba(255,255,255,0.06); color: var(--text); }
  nav.mainnav a.active {
    background: linear-gradient(135deg, rgba(139,92,246,0.25), rgba(59,130,246,0.25));
    color: var(--text);
    border: 1px solid rgba(139,92,246,0.4);
  }
  .topbar-right { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 8px 12px;
    min-width: 200px;
  }
  .search-box input {
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-size: 14px;
    width: 100%;
    min-width: 0;
  }
  .icon-btn {
    width: 36px; height: 36px; flex-shrink: 0;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--panel-border);
    cursor: pointer;
  }
  .avatar {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--accent1), var(--accent3));
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 13px;
  }
  .menu-toggle { display: none; }

  /* Mobile dropdown nav */
  .mobile-nav {
    display: none;
    position: fixed;
    top: var(--topbar-h);
    left: 0; right: 0;
    z-index: 55;
    padding: 10px 16px 16px;
    background: rgba(10,14,26,0.98);
    border-bottom: 1px solid var(--panel-border);
    flex-direction: column;
    gap: 4px;
  }
  .mobile-nav.open { display: flex; }
  .mobile-nav a {
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 15px;
    color: var(--text-dim);
  }
  .mobile-nav a.active { background: rgba(139,92,246,0.18); color: var(--text); }
  .mobile-search { display: none; padding: 12px 16px; }
  .mobile-search .search-box { min-width: 0; width: 100%; }

  main { max-width: 1200px; margin: 0 auto; padding: 24px 20px 110px; width: 100%; }

  h1.page-title { font-size: 24px; margin: 0 0 4px; }
  p.page-sub { color: var(--text-dim); margin: 0 0 22px; font-size: 14px; }

  .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: 14px; margin-bottom: 24px; }
  .stat-card { padding: 18px; }
  .stat-card .label { color: var(--text-dim); font-size: 12.5px; margin-bottom: 8px; }
  .stat-card .value { font-size: 26px; font-weight: 700; }
  .stat-card .value.accent { background: linear-gradient(90deg, var(--accent1), var(--accent3)); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .two-col { display: grid; grid-template-columns: 1.3fr 1fr; gap: 18px; }

  .section-title { font-size: 15px; font-weight: 600; margin: 0 0 14px; color: var(--text); }
  .panel { padding: 20px; }

  .quick-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    padding: 11px 18px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    transition: transform 0.15s ease, opacity 0.15s ease;
    white-space: nowrap;
  }
  .btn:active { transform: scale(0.98); }
  .btn-primary { background: linear-gradient(135deg, var(--accent1), var(--accent2)); color: white; }
  .btn-secondary { background: rgba(255,255,255,0.07); color: var(--text); border: 1px solid var(--panel-border); }
  .btn-danger { background: rgba(248,113,113,0.15); color: var(--danger); border: 1px solid rgba(248,113,113,0.3); }
  .btn-sm { padding: 7px 12px; font-size: 13px; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-block { width: 100%; }

  .activity-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .activity-list li {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; border-radius: 10px;
    background: rgba(255,255,255,0.03);
    font-size: 13.5px; color: var(--text-dim);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent3); flex-shrink: 0; }

  /* Gallery */
  .gallery-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; gap: 12px; flex-wrap: wrap; }
  .gallery-toolbar form { display: flex; gap: 10px; flex-wrap: wrap; flex: 1; min-width: 0; }
  .gallery-toolbar form input[type=text] { flex: 1; min-width: 140px; }
  select, input[type=text], input[type=search], textarea {
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--panel-border);
    color: var(--text);
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    outline: none;
    width: 100%;
  }
  select, input[type=text]:not(.form-group input) { width: auto; }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 16px; }
  .card {
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:active { transform: scale(0.98); }
  .card .thumb {
    width: 100%; height: 140px;
    background: linear-gradient(135deg, rgba(139,92,246,0.25), rgba(34,211,238,0.15));
    display: flex; align-items: center; justify-content: center;
    font-size: 32px;
    overflow: hidden;
  }
  .card .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card .body { padding: 13px; }
  .card .name { font-weight: 600; font-size: 14.5px; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card .headline { color: var(--text-dim); font-size: 12.5px; margin-bottom: 12px; min-height: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card .actions { display: flex; gap: 8px; }
  .card .actions .btn { flex: 1; }

  .empty-state { text-align: center; padding: 50px 16px; color: var(--text-dim); }
  .empty-state .emoji { font-size: 38px; margin-bottom: 12px; }

  /* Forms */
  .form-grid { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .form-group label { display: block; font-size: 13px; color: var(--text-dim); margin-bottom: 6px; }
  .form-group input, .form-group textarea { width: 100%; }
  .form-group textarea { min-height: 110px; resize: vertical; font-family: inherit; }
  .form-actions { display: flex; gap: 10px; margin-top: 6px; flex-wrap: wrap; }
  .form-actions .btn { flex: 1; min-width: 130px; }
  .file-drop {
    display: block;
    border: 1.5px dashed var(--panel-border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    color: var(--text-dim);
    font-size: 13px;
    cursor: pointer;
  }
  .file-drop.has-file { border-color: var(--accent3); color: var(--text); }
  .error-box {
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.3);
    color: #fca5a5;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 13px;
    margin-bottom: 16px;
  }
  .success-box {
    background: rgba(52,211,153,0.1);
    border: 1px solid rgba(52,211,153,0.3);
    color: #6ee7b7;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 13px;
    margin-bottom: 16px;
  }

  /* Item detail */
  .item-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .item-image {
    border-radius: var(--radius);
    overflow: hidden;
    height: 300px;
    background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(34,211,238,0.12));
    display: flex; align-items: center; justify-content: center;
    font-size: 54px;
  }
  .item-image img { width: 100%; height: 100%; object-fit: cover; }
  .meta-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--panel-border); font-size: 13px; gap: 10px; }
  .meta-row .k { color: var(--text-dim); flex-shrink: 0; }
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 12px; background: rgba(52,211,153,0.12); color: var(--success); }

  /* Database */
  .table-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.db-table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 420px; }
  table.db-table th, table.db-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--panel-border); white-space: nowrap; }
  table.db-table th { color: var(--text-dim); font-weight: 500; }

  /* Settings */
  .settings-list { display: flex; flex-direction: column; gap: 0; }
  .settings-row { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--panel-border); gap: 12px; flex-wrap: wrap; }
  .settings-row:last-child { border-bottom: none; }
  .settings-row .label { font-size: 14px; }
  .settings-row .sub { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .theme-toggle { display: flex; gap: 8px; }
  .theme-pill { padding: 6px 14px; border-radius: 999px; font-size: 12px; background: rgba(255,255,255,0.06); cursor: pointer; border: 1px solid transparent; }
  .theme-pill.active { border-color: var(--accent3); color: var(--accent3); }

  /* Modal / Lightbox */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(5,7,14,0.75);
    backdrop-filter: blur(4px);
    display: none; align-items: center; justify-content: center;
    z-index: 200; padding: 16px;
  }
  .modal-overlay.open { display: flex; }
  .modal-box { width: 100%; max-width: 640px; max-height: 92vh; overflow-y: auto; padding: 0; }
  .modal-image {
    width: 100%; height: 240px;
    background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(34,211,238,0.12));
    display: flex; align-items: center; justify-content: center; font-size: 46px;
    overflow: hidden;
  }
  .modal-image img { width: 100%; height: 100%; object-fit: cover; }
  .modal-body { padding: 20px; }
  .modal-close {
    position: absolute; top: 12px; right: 12px;
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(0,0,0,0.45); color: white;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; border: none; font-size: 16px; z-index: 2;
  }
  .modal-wrap { position: relative; }

  /* Toast notifications */
  #toast-stack {
    position: fixed; top: calc(var(--topbar-h) + 8px + env(safe-area-inset-top,0px)); right: 16px; left: 16px;
    z-index: 300; display: flex; flex-direction: column; align-items: flex-end; gap: 10px;
    pointer-events: none;
  }
  .toast {
    padding: 12px 16px; border-radius: 10px;
    background: rgba(20,24,38,0.97); border: 1px solid var(--panel-border);
    font-size: 13px; box-shadow: var(--shadow);
    animation: slideIn 0.25s ease;
    max-width: 300px;
    pointer-events: auto;
  }
  .toast.success { border-color: rgba(52,211,153,0.4); }
  .toast.error { border-color: rgba(248,113,113,0.4); }
  @keyframes slideIn { from { opacity:0; transform: translateX(20px);} to {opacity:1; transform:none;} }

  /* Nano AI */
  .nano-fab {
    position: fixed; z-index: 150;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    right: 20px;
    display: flex; align-items: center; gap: 8px;
    padding: 13px 18px; border-radius: 999px;
    background: linear-gradient(135deg, var(--accent1), var(--accent3));
    color: white; font-weight: 600; font-size: 14px;
    cursor: pointer; box-shadow: 0 10px 30px rgba(139,92,246,0.4);
    border: none;
  }
  .nano-panel {
    position: fixed; z-index: 150;
    bottom: calc(84px + env(safe-area-inset-bottom, 0px));
    right: 20px;
    width: 340px; max-width: calc(100vw - 32px);
    height: 440px; max-height: 70vh;
    display: none; flex-direction: column;
    overflow: hidden;
  }
  .nano-panel.open { display: flex; }
  .nano-head {
    padding: 14px 16px; border-bottom: 1px solid var(--panel-border);
    display: flex; align-items: center; justify-content: space-between;
    font-weight: 600; font-size: 14px;
  }
  .online-dot { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--success); font-weight: 500; }
  .online-dot::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--success); }
  .nano-messages { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  .msg { max-width: 85%; padding: 10px 13px; border-radius: 12px; font-size: 13px; line-height: 1.45; }
  .msg.bot { align-self: flex-start; background: rgba(255,255,255,0.06); }
  .msg.user { align-self: flex-end; background: linear-gradient(135deg, var(--accent1), var(--accent2)); color: white; }
  .nano-input-row { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--panel-border); }
  .nano-input-row input { flex: 1; }
  .nano-send {
    width: 40px; height: 40px; flex-shrink: 0; border-radius: 10px; border: none;
    background: linear-gradient(135deg, var(--accent1), var(--accent3));
    color: white; cursor: pointer; display: flex; align-items: center; justify-content: center;
  }

  .error-page { text-align: center; padding: 80px 16px; }
  .error-page .code { font-size: 60px; font-weight: 800; background: linear-gradient(90deg, var(--accent1), var(--accent3)); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* ---------- Responsive breakpoints ---------- */
  @media (max-width: 860px) {
    .two-col { grid-template-columns: 1fr; }
    .item-detail { grid-template-columns: 1fr; }
  }

  @media (max-width: 700px) {
    nav.mainnav { display: none; }
    .topbar-right .search-box { display: none; }
    .menu-toggle {
      display: flex; align-items: center; justify-content: center;
      width: 38px; height: 38px; border-radius: 10px;
      background: rgba(255,255,255,0.06); border: 1px solid var(--panel-border);
      cursor: pointer; font-size: 16px; flex-shrink: 0;
    }
    .mobile-search { display: block; }
    main { padding: 18px 14px 110px; }
    h1.page-title { font-size: 21px; }
    .gallery-grid { grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); gap: 12px; }
    .card .thumb { height: 110px; }
    .nano-fab span.fab-label { display: none; }
    .nano-fab { padding: 14px; border-radius: 50%; }
    .nano-panel {
      right: 12px; left: 12px; width: auto; max-width: none;
      bottom: calc(78px + env(safe-area-inset-bottom, 0px));
      height: 62vh;
    }
    #toast-stack { align-items: stretch; }
    .toast { max-width: none; }
    .gallery-toolbar { flex-direction: column; align-items: stretch; }
    .gallery-toolbar form { flex-direction: column; }
    .gallery-toolbar > a.btn { width: 100%; }
    select { width: 100%; }
    .form-actions { flex-direction: column; }
    .form-actions .btn, .form-actions form { width: 100%; }
    .form-actions form button { width: 100%; }
  }

  @media (max-width: 420px) {
    .grid-stats { grid-template-columns: repeat(2, 1fr); }
    .stat-card .value { font-size: 22px; }
  }
</style>
</head>
<body>

<div id="toast-stack"></div>

<header class="topbar">
  <div class="menu-toggle" id="menu-toggle" onclick="toggleMobileNav()">☰</div>
  <div class="brand">🤖 NANO SPACE</div>
  <nav class="mainnav">
    <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>">📊 Dashboard</a>
    <a href="/gallery" class="<%= page === 'gallery' || page === 'item' ? 'active' : '' %>">🖼 Gallery</a>
    <a href="/create" class="<%= page === 'create' || page === 'edit' ? 'active' : '' %>">📝 Create</a>
    <a href="/database" class="<%= page === 'database' ? 'active' : '' %>">🗄 Database</a>
    <a href="/settings" class="<%= page === 'settings' ? 'active' : '' %>">⚙️ Settings</a>
  </nav>
  <div class="topbar-right">
    <form class="search-box" action="/gallery" method="GET">
      <span>🔍</span>
      <input type="text" name="q" placeholder="Search gallery..." value="<%= typeof search !== 'undefined' ? search : '' %>">
    </form>
    <div class="icon-btn" title="Notifications">🔔</div>
    <div class="avatar">NC</div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav">
  <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>" onclick="closeMobileNav()">📊 Dashboard</a>
  <a href="/gallery" class="<%= page === 'gallery' || page === 'item' ? 'active' : '' %>" onclick="closeMobileNav()">🖼 Gallery</a>
  <a href="/create" class="<%= page === 'create' || page === 'edit' ? 'active' : '' %>" onclick="closeMobileNav()">📝 Create</a>
  <a href="/database" class="<%= page === 'database' ? 'active' : '' %>" onclick="closeMobileNav()">🗄 Database</a>
  <a href="/settings" class="<%= page === 'settings' ? 'active' : '' %>" onclick="closeMobileNav()">⚙️ Settings</a>
  <form class="mobile-search" action="/gallery" method="GET">
    <div class="search-box">
      <span>🔍</span>
      <input type="text" name="q" placeholder="Search gallery..." value="<%= typeof search !== 'undefined' ? search : '' %>">
    </div>
  </form>
</div>

<main>

<% if (page === 'dashboard') { %>
  <h1 class="page-title">Dashboard</h1>
  <p class="page-sub">Good afternoon, Creator! Your local JSON data store is live and synced.</p>

  <div class="grid-stats">
    <div class="glass stat-card">
      <div class="label">Total Items</div>
      <div class="value accent"><%= stats.totalItems %></div>
    </div>
    <div class="glass stat-card">
      <div class="label">Media Assets</div>
      <div class="value accent"><%= stats.mediaAssets %></div>
    </div>
    <div class="glass stat-card">
      <div class="label">Storage Read</div>
      <div class="value"><%= stats.latencyMs %>ms</div>
    </div>
  </div>

  <div class="two-col">
    <div class="glass panel">
      <div class="section-title">Quick Actions</div>
      <div class="quick-actions">
        <a class="btn btn-primary" href="/create">➕ Add New Content</a>
        <button class="btn btn-secondary" onclick="openNano()">🤖 Ask Nano AI</button>
      </div>
    </div>
    <div class="glass panel">
      <div class="section-title">Recent Activity</div>
      <ul class="activity-list">
        <% if (activity.length === 0) { %>
          <li>No recent activity yet.</li>
        <% } %>
        <% activity.forEach(a => { %>
          <li><span class="dot"></span> <%= a.message %></li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>

<% if (page === 'gallery') { %>
  <h1 class="page-title">Gallery</h1>
  <p class="page-sub">Browse and manage your JSON-backed content.</p>

  <div class="gallery-toolbar">
    <form method="GET" action="/gallery">
      <input type="text" name="q" placeholder="Search by name, headline, description..." value="<%= search %>">
      <select name="sort" onchange="this.form.submit()">
        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest first</option>
        <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
      </select>
      <button class="btn btn-secondary" type="submit">Apply</button>
    </form>
    <a class="btn btn-primary" href="/create">➕ Add New Content</a>
  </div>

  <% if (items.length === 0) { %>
    <div class="glass empty-state">
      <div class="emoji">🖼️</div>
      <div>No items found. Try a different search or add new content.</div>
    </div>
  <% } else { %>
    <div class="gallery-grid">
      <% items.forEach(item => { %>
        <div class="glass card" data-item-id="<%= item.id %>"
             data-name="<%= item.name %>" data-headline="<%= item.headline %>"
             data-description="<%= item.description %>" data-image="<%= item.image_url %>"
             data-created="<%= item.created_at %>"
             onclick="openLightbox(this)">
          <div class="thumb">
            <% if (item.image_url) { %><img src="<%= item.image_url %>" alt="<%= item.name %>"><% } else { %>🖼️<% } %>
          </div>
          <div class="body">
            <div class="name"><%= item.name %></div>
            <div class="headline"><%= item.headline %></div>
            <div class="actions" onclick="event.stopPropagation()">
              <button class="btn btn-secondary btn-sm" onclick="openLightbox(this.closest('.card'))">Inspect</button>
              <a class="btn btn-secondary btn-sm" href="/edit/<%= item.id %>">Edit</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
<% } %>

<% if (page === 'create' || page === 'edit') { %>
  <h1 class="page-title"><%= page === 'create' ? 'Create Content' : 'Edit Content' %></h1>
  <p class="page-sub">Save your content directly to the local JSON store.</p>

  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <div class="error-box">
      <% errors.forEach(e => { %>• <%= e %><br><% }) %>
    </div>
  <% } %>

  <form class="form-grid glass panel" method="POST"
        action="<%= page === 'create' ? '/create' : '/edit/' + item.id %>"
        enctype="multipart/form-data">
    <div class="form-group">
      <label>Item Name</label>
      <input type="text" name="name" required maxlength="160"
             value="<%= page === 'create' ? (values && values.name ? values.name : '') : item.name %>">
    </div>
    <div class="form-group">
      <label>Text Headline</label>
      <input type="text" name="headline" maxlength="240"
             value="<%= page === 'create' ? (values && values.headline ? values.headline : '') : item.headline %>">
    </div>
    <div class="form-group">
      <label>Full Description</label>
      <textarea name="description" maxlength="5000"><%= page === 'create' ? (values && values.description ? values.description : '') : item.description %></textarea>
    </div>
    <div class="form-group">
      <label>Image Upload</label>
      <label class="file-drop" id="file-drop-label">
        <span id="file-drop-text">Tap to choose an image (JPG, PNG, WEBP, GIF — max 5MB)</span>
        <input type="file" name="image" accept="image/*" style="display:none" id="file-input"
               onchange="handleFileChange(this)">
      </label>
    </div>
    <div class="form-actions">
      <a class="btn btn-secondary" href="<%= page === 'create' ? '/gallery' : '/item/' + item.id %>">Cancel</a>
      <button class="btn btn-primary" type="submit">💾 Save to JSON Store</button>
    </div>
  </form>
<% } %>

<% if (page === 'item') { %>
  <% if (created) { %><div class="success-box">✅ Item saved successfully.</div><% } %>
  <a class="btn btn-secondary btn-sm" href="/gallery" style="margin-bottom:16px; display:inline-flex;">← Back to Gallery</a>

  <div class="item-detail">
    <div class="item-image">
      <% if (item.image_url) { %><img src="<%= item.image_url %>" alt="<%= item.name %>"><% } else { %>🖼️<% } %>
    </div>
    <div class="glass panel">
      <h1 class="page-title" style="font-size:20px;"><%= item.name %></h1>
      <p class="page-sub" style="margin-bottom:16px;"><%= item.headline %></p>
      <p style="color: var(--text-dim); font-size:14px; line-height:1.6; margin-bottom:20px;"><%= item.description || 'No description provided.' %></p>

      <div class="meta-row"><span class="k">Record ID</span><span>#<%= item.id %></span></div>
      <div class="meta-row"><span class="k">Storage Sync Status</span><span class="badge">✓ Synced</span></div>
      <div class="meta-row"><span class="k">Created</span><span><%= new Date(item.created_at).toLocaleString() %></span></div>

      <div class="form-actions" style="margin-top:20px;">
        <a class="btn btn-primary" href="/edit/<%= item.id %>">Edit Item</a>
        <form method="POST" action="/delete/<%= item.id %>" onsubmit="return confirm('Delete this item permanently?');">
          <button class="btn btn-danger btn-block" type="submit">Delete from Store</button>
        </form>
      </div>
    </div>
  </div>
<% } %>

<% if (page === 'database') { %>
  <h1 class="page-title">Database</h1>
  <p class="page-sub">Local JSON store <%= connected ? '— Connected' : '— Read error' %></p>

  <div class="grid-stats">
    <div class="glass stat-card">
      <div class="label">Storage Status</div>
      <div class="value" style="font-size:18px; color: <%= connected ? 'var(--success)' : 'var(--danger)' %>;">
        <%= connected ? '🟢 Connected' : '🔴 Error' %>
      </div>
    </div>
    <div class="glass stat-card">
      <div class="label">Total Records</div>
      <div class="value accent"><%= stats.totalItems %></div>
    </div>
    <div class="glass stat-card">
      <div class="label">Read Latency</div>
      <div class="value"><%= stats.latencyMs !== null ? stats.latencyMs + 'ms' : '—' %></div>
    </div>
  </div>

  <div class="glass panel">
    <div class="section-title">Recent Records</div>
    <% if (recentRecords.length === 0) { %>
      <p style="color: var(--text-dim); font-size: 14px;">No records yet.</p>
    <% } else { %>
    <div class="table-scroll">
    <table class="db-table">
      <thead><tr><th>ID</th><th>Name</th><th>Updated</th></tr></thead>
      <tbody>
        <% recentRecords.forEach(r => { %>
          <tr>
            <td>#<%= r.id %></td>
            <td><a href="/item/<%= r.id %>"><%= r.name %></a></td>
            <td><%= new Date(r.updated_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
<% } %>

<% if (page === 'settings') { %>
  <h1 class="page-title">Settings</h1>
  <p class="page-sub">Application configuration overview.</p>

  <div class="glass panel">
    <div class="settings-list">
      <div class="settings-row">
        <div><div class="label">Application Name</div><div class="sub">Displayed across the dashboard</div></div>
        <div><%= settings.appName %></div>
      </div>
      <div class="settings-row">
        <div><div class="label">Data Storage</div><div class="sub">JSON files on disk</div></div>
        <span class="badge">✓ <%= settings.dataDir %></span>
      </div>
      <div class="settings-row">
        <div><div class="label">Environment</div><div class="sub">NODE_ENV</div></div>
        <div><%= settings.environment %></div>
      </div>
      <div class="settings-row">
        <div><div class="label">Upload Directory</div><div class="sub">Where images are stored</div></div>
        <div><%= settings.uploadDir %></div>
      </div>
      <div class="settings-row">
        <div><div class="label">Max Upload Size</div><div class="sub">Per image</div></div>
        <div><%= settings.maxUploadSizeMb %>MB</div>
      </div>
      <div class="settings-row">
        <div><div class="label">Theme Preference</div><div class="sub">UI only, not persisted</div></div>
        <div class="theme-toggle">
          <div class="theme-pill active">Dark</div>
          <div class="theme-pill">Light</div>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (page === 'error') { %>
  <div class="error-page">
    <div class="code"><%= errorCode %></div>
    <p style="color: var(--text-dim); margin-bottom: 20px;"><%= errorMessage %></p>
    <a class="btn btn-primary" href="/">Back to Dashboard</a>
  </div>
<% } %>

</main>

<!-- Lightbox / Inspection Modal -->
<div class="modal-overlay" id="lightbox">
  <div class="glass modal-box modal-wrap">
    <button class="modal-close" onclick="closeLightbox()">✕</button>
    <div class="modal-image" id="lb-image">🖼️</div>
    <div class="modal-body">
      <h2 id="lb-name" style="margin:0 0 6px; font-size:19px;"></h2>
      <p id="lb-headline" style="color:var(--text-dim); margin:0 0 14px;"></p>
      <p id="lb-description" style="font-size:14px; line-height:1.6; color: var(--text-dim); margin-bottom:18px;"></p>
      <div class="meta-row"><span class="k">Record ID</span><span id="lb-id"></span></div>
      <div class="meta-row"><span class="k">Storage Sync Status</span><span class="badge">✓ Synced</span></div>
      <div class="form-actions" style="margin-top:18px;">
        <a class="btn btn-primary" id="lb-edit" href="#">Edit Item</a>
        <form method="POST" id="lb-delete-form" action="#" onsubmit="return confirm('Delete this item permanently?');">
          <button class="btn btn-danger btn-block" type="submit">Delete</button>
        </form>
        <button class="btn btn-secondary" type="button" onclick="closeLightbox()">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Nano AI -->
<button class="nano-fab" id="nano-fab" onclick="toggleNano()">🤖 ✨ <span class="fab-label">Ask Nano</span></button>
<div class="glass nano-panel" id="nano-panel">
  <div class="nano-head">
    <span>🤖 Nano AI</span>
    <span class="online-dot">Online</span>
  </div>
  <div class="nano-messages" id="nano-messages">
    <div class="msg bot">👋 Hey! I'm Nano. Ask me about your gallery stats, recent uploads, or storage status.</div>
  </div>
  <div class="nano-input-row">
    <input type="text" id="nano-input" placeholder="Ask Nano..." onkeydown="if(event.key==='Enter') sendNano();">
    <button class="nano-send" onclick="sendNano()">➤</button>
  </div>
</div>

<script>
  // ---------- Mobile nav ----------
  function toggleMobileNav() {
    document.getElementById('mobile-nav').classList.toggle('open');
  }
  function closeMobileNav() {
    document.getElementById('mobile-nav').classList.remove('open');
  }

  // ---------- Toasts ----------
  function toast(message, type) {
    const stack = document.getElementById('toast-stack');
    const el = document.createElement('div');
    el.className = 'toast ' + (type || '');
    el.textContent = message;
    stack.appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }
  <% if (typeof created !== 'undefined' && created) { %> toast('Item saved successfully.', 'success'); <% } %>

  // ---------- Lightbox ----------
  function openLightbox(card) {
    const id = card.dataset.itemId;
    document.getElementById('lb-name').textContent = card.dataset.name;
    document.getElementById('lb-headline').textContent = card.dataset.headline;
    document.getElementById('lb-description').textContent = card.dataset.description || 'No description provided.';
    document.getElementById('lb-id').textContent = '#' + id;
    document.getElementById('lb-edit').href = '/edit/' + id;
    document.getElementById('lb-delete-form').action = '/delete/' + id;

    const imgWrap = document.getElementById('lb-image');
    imgWrap.innerHTML = card.dataset.image ? '<img src="' + card.dataset.image + '" alt="">' : '🖼️';
    document.getElementById('lightbox').classList.add('open');
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
  }
  document.getElementById('lightbox').addEventListener('click', (e) => {
    if (e.target.id === 'lightbox') closeLightbox();
  });

  // ---------- File input ----------
  function handleFileChange(input) {
    const label = document.getElementById('file-drop-label');
    const text = document.getElementById('file-drop-text');
    if (input.files && input.files[0]) {
      label.classList.add('has-file');
      text.textContent = '✓ ' + input.files[0].name;
    }
  }

  // ---------- Nano AI ----------
  function toggleNano() {
    document.getElementById('nano-panel').classList.toggle('open');
  }
  function openNano() {
    document.getElementById('nano-panel').classList.add('open');
  }
  async function sendNano() {
    const input = document.getElementById('nano-input');
    const text = input.value.trim();
    if (!text) return;
    const messages = document.getElementById('nano-messages');

    const userMsg = document.createElement('div');
    userMsg.className = 'msg user';
    userMsg.textContent = text;
    messages.appendChild(userMsg);
    input.value = '';
    messages.scrollTop = messages.scrollHeight;

    const thinking = document.createElement('div');
    thinking.className = 'msg bot';
    thinking.textContent = 'Thinking...';
    messages.appendChild(thinking);
    messages.scrollTop = messages.scrollHeight;

    try {
      const res = await fetch('/api/ai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text })
      });
      const data = await res.json();
      thinking.textContent = data.reply || "Sorry, I couldn't process that.";
    } catch (e) {
      thinking.textContent = 'Something went wrong reaching Nano.';
    }
    messages.scrollTop = messages.scrollHeight;
  }
</script>

</body>
</html>
